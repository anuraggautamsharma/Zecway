# Supabase project (auth + waitlist + knowledge graph) — Project Settings → API.
# Optional locally: the code falls back to the Zecway project's publishable values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# AI provider (free tier from aistudio.google.com during development).
# Required: powers embeddings (the knowledge graph) and web-grounded search.
GEMINI_API_KEY=

# Optional: Cerebras (free tier at cloud.cerebras.ai, ~1M tokens/day, no card).
# When set, generation/reasoning runs on Cerebras (fast) while Gemini keeps
# doing embeddings + web search. Leave blank to run everything on Gemini.
CEREBRAS_API_KEY=
