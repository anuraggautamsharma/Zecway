# Supabase project (auth + waitlist + knowledge graph) — Project Settings → API.
# Optional locally: the code falls back to the Zecway project's publishable values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

